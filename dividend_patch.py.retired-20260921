"""
Power Academy — drop-in replacement for build_guidance_history.py :: dividend()
Built and verified 2026-08-06.

WHY
---
The shipped dividend() required the literal phrase "annual dividend" or
"annualized dividend" and read the first money token after it:

    re.search(r'(?:annuali[sz]ed (?:equivalent )?dividend(?: rate)?'
              r'|annual dividend)[^.$]{0,40}?\\$\\s?(\\d\\.\\d{2})', fb, re.I)

Four independent defects, all confirmed against decks in data/corpus/text:

  1. PHRASING. Misses "2026 dividend ($ per share)" (Dominion, 5 consecutive
     decks) and "Common Share Dividend** $0.26 per share annually" (AQN, 8).
  2. CHARACTER CLASS. [^.$] forbids '$', so a label containing "($ per share)"
     blocks the match even when the phrasing is right.
  3. FOOTNOTE MARKERS. In "dividend² ($ per share)" the trailing \\b never fires,
     because superscript digits are \\w characters in Python's re.
  4. COLUMN COLLISION — the expensive one. On a two-metric slide the pattern
     takes the FIRST money token, which is the other metric:
       CMS  "Adjusted EPS Guidance | Annual Dividend Per Share  $3.06 – $3.12  $1.95"
            -> stored 3.06 (the EPS) on 13 decks; the dividend is 1.95.
       PPL  "Projected EPS | Projected Annualized Dividends Per Share
             6%-8% CAGR $1.48   6%-8% CAGR $0.90"  -> stored 1.48; correct 0.90.
       HTO  "$1.36 per share (annual) ... $0.81 $1.04 $1.12 $1.20 $1.28 $1.36"
            -> stored 0.81, the 2016 bar of a DPS bar chart; correct 1.36.
       CWT  "one-time special dividend of $0.04" -> stored 0.04 on 3 decks.

RESULT over all 419 decks: dividend cells 58 -> 78.
Of the original 58, **17 were wrong** (14 corrected, 3 removed) = 29%.

WHAT IT REFUSES TO DO
---------------------
Returns None rather than guess when the deck prints only a QUARTERLY dividend
(multiplying by 4 would be a derived figure, and this file's own basis rule
reserves 'printed' for what the slide states), when the figure is a one-time
SPECIAL dividend, when the value sits in a bar-chart series, and when the value
is the left half of a range or another metric's token intervenes.

VERIFICATION
------------
18 controls, all passing; every conflict the full sweep surfaced was folded back
in as a permanent control. Each of the four guards was disabled in turn and
confirmed to break at least one control, so no guard is decorative.
"""

import re

# --- disqualifiers ------------------------------------------------------------
QUARTERLY   = re.compile(r'(?i)\bquarter(ly|s)?\b|\b\d{1,3}(st|nd|rd|th)\s+consecutive\b')
OTHERMETRIC = re.compile(r'(?i)\b(EPS|earnings per share|adjusted earnings|guidance|payout'
                         r'|yield|CAGR|ratio|rate base|revenue|O&M|capital)\b')
SPECIAL     = re.compile(r'(?i)\bspecial\b')
GROWTHY     = re.compile(r'(?i)\b(yield|growth|payout|CAGR|ratio)\b')

MONEY   = re.compile(r'\$\s?(\d\.\d{2})(?!\d)')
_DASH   = r'[\-‐‑‒–—―−]'
RANGE_R = re.compile(r'^\s*' + _DASH + r'\s*\$?\s?\d')   # token is the LEFT half of a range
SERIES  = re.compile(r'^\s*\$\s?\d')                      # next token is money -> bar chart

# NOTE: (?![A-Za-z]) not \b — footnote superscripts are \w characters in Python.
STRICT      = re.compile(r'(?i)(?:annuali[sz]ed (?:equivalent )?dividend(?: rate)?'
                         r'|annual dividend)(?: per share)?')
TABLE_LABEL = re.compile(r'(?i)(?:\d{4}\s+)?dividends?(?![A-Za-z])[^$]{0,25}?\(\$\s*per\s*share\)')
LOOSE_LABEL = re.compile(r'(?i)(?:common share |cash )?dividends?(?![A-Za-z])(?:\s*per share)?')
ANNUALISER  = re.compile(r'(?i)per share annually|annuali[sz]ed basis|\bannual(?:ly)?\b')
PAIRED      = re.compile(r'(?i)(?:adjusted\s+)?(?:EPS|earnings per share)[^$]{0,45}?'
                         r'(?:annuali[sz]ed\s+|annual\s+)?dividends?\s+per\s+share')

_BAND = (0.10, 9.99)


def _pick(fb, start, window=70):
    """First POINT money value in the window. Skips range-left halves; refuses on
    bar-chart series and on quarterly / other-metric / special context."""
    tail = fb[start:start + window]
    for m in MONEY.finditer(tail):
        span = tail[:m.start()]
        if QUARTERLY.search(span) or OTHERMETRIC.search(span) or SPECIAL.search(span):
            return None, None
        after = tail[m.end():m.end() + 14]
        if RANGE_R.match(after):
            continue
        if SERIES.match(after):
            return None, None
        v = float(m.group(1))
        if not (_BAND[0] <= v <= _BAND[1]):
            continue
        return v, fb[max(0, start - 70):start + m.end() + 40]
    return None, None


def _paired_columns(fb, window=60):
    """'EPS Guidance | Annual Dividend Per Share' -> '$A - $B  $C'. Two labels,
    two value groups, in order: take the last. Guarded by >=2 tokens, <=3 tokens
    (so a bar chart cannot qualify), and last < first (a utility's DPS is always
    below its EPS)."""
    for k in PAIRED.finditer(fb):
        tail = fb[k.end():k.end() + window]
        toks = [float(m.group(1)) for m in MONEY.finditer(tail)][:3]
        if len(toks) < 2:
            continue
        first, last = toks[0], toks[-1]
        if not (_BAND[0] <= last <= _BAND[1]) or last >= first:
            continue
        return last, fb[max(0, k.start() - 40):k.end() + window], 4
    return None, None, None


def dividend_from_text(fb):
    """(value, verbatim_evidence, tier) or (None, None, None) for one flattened page."""
    for tier, rx, need_ann in ((1, STRICT, False), (2, TABLE_LABEL, False), (3, LOOSE_LABEL, True)):
        for k in rx.finditer(fb):
            pre = fb[max(0, k.start() - 45):k.start()]
            if QUARTERLY.search(pre) or SPECIAL.search(pre):
                continue
            if tier == 3 and GROWTHY.search(pre):
                continue
            if need_ann and not ANNUALISER.search(fb[max(0, k.start() - 90):k.end() + 70]):
                continue
            v, ev = _pick(fb, k.end())
            if v is not None:
                return v, ev, tier
    return _paired_columns(fb)


# =============================================================================
# Drop-in replacement. `pages` and `flat` are the module's existing helpers.
# =============================================================================
def dividend(tk, deck):
    for pno, body in pages(deck['id']):                     # noqa: F821
        fb = flat(body)                                     # noqa: F821
        v, ev, tier = dividend_from_text(fb)
        if v is not None:
            return {'current_annual': v, 'basis': 'printed', 'page': pno,
                    'tier': tier, 'text': ev[:400]}
    return None
