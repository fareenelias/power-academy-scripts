"""
fetch_market_data.py
--------------------
Fetches live price + marketCap from FMP /stable/quote for all 23 coverage tickers,
then merges with capiq_export.json to produce market_data.json.

Derived metrics (all computed here, not sourced from FMP ratios):
  - equity_value_b   : marketCap from FMP (billions)
  - net_debt_b       : net_debt latest from capiq (billions, thousands -> B)
  - firm_value_b     : equity_value_b + net_debt_b
  - price            : live from FMP
  - eps_fy  / fy_label   : capiq eps_diluted[4] / periods[4]  (2026FY E)
  - eps_fy1 / fy1_label  : capiq eps_diluted[5] / periods[5]  (2027FY E)
  - eps_fy2 / fy2_label  : capiq eps_diluted[6] / periods[6]  (2028FY E)
  - pe_fy / pe_fy1 / pe_fy2 : price / eps (None if eps <= 0 or missing)
  - div_per_share    : dividends_ps[-1] from capiq (most recent annual)
  - div_yield_pct    : div_per_share / price * 100
  - payout_pct       : div_per_share / eps_fy * 100
  - rate_base_b      : best available (rate case opco sum → NUP fallback)
  - rate_base_label  : source disclosure string
  - rate_base_source : 'rate_case' | 'net_utility_plant'
  - fv_rate_base_x   : firm_value_b / rate_base_b (multiple)

Rate base hierarchy (per company):
  1. Sum of all rate_base_opcos entries (rate case data, labeled with test year)
  2. net_utility_plant_latest * 1000 (GAAP balance sheet, labeled accordingly)

Run:
  python fetch_market_data.py --capiq E:/PowerAcademy/data/capiq_export.json \
                               --out   E:/PowerAcademy/data/market_data.json \
                               --apikey YOUR_FMP_KEY

Outputs market_data.json to --out path.
Also prints a summary table to stdout.
"""

import argparse
import os
import json
import time
import urllib.request
import urllib.error
from datetime import datetime

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
parser = argparse.ArgumentParser()
parser.add_argument("--capiq",  required=True, help="Path to capiq_export.json")
parser.add_argument("--out",    required=True, help="Output path for market_data.json")
parser.add_argument("--apikey", required=True, help="FMP API key")
parser.add_argument("--delay",  type=float, default=0.25, help="Seconds between FMP calls")
args = parser.parse_args()

# ---------------------------------------------------------------------------
# Load capiq + IP rate base
# ---------------------------------------------------------------------------
with open(args.capiq, "r", encoding="utf-8") as f:
    capiq_raw = json.load(f)

companies = capiq_raw.get("companies", capiq_raw)  # handle both wrapped and flat
tickers = list(companies.keys())
print(f"Loaded {len(tickers)} companies from capiq_export.json")

# Load IP rate base (optional - same dir as capiq by default)
ip_path = os.path.join(os.path.dirname(args.capiq), "rate_base_ip.json")
ip_data = {}
if os.path.exists(ip_path):
    with open(ip_path, "r", encoding="utf-8") as f:
        raw = json.load(f)
    ip_data = raw.get("companies", raw)
    print(f"Loaded IP rate base for {len(ip_data)} companies from rate_base_ip.json")
else:
    print(f"Note: rate_base_ip.json not found at {ip_path} — using NUP fallback for all companies")

# ---------------------------------------------------------------------------
# FMP fetch helpers
# ---------------------------------------------------------------------------
BASE = "https://financialmodelingprep.com/stable"

def fmp_get(path, apikey):
    sep = "&" if "?" in path else "?"
    url = f"{BASE}{path}{sep}apikey={apikey}"
    try:
        with urllib.request.urlopen(url, timeout=10) as r:
            return json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        print(f"  HTTP {e.code} for {path}")
        return None
    except Exception as e:
        print(f"  Error fetching {path}: {e}")
        return None

def fetch_quotes(tickers, apikey, delay=0.25):
    """Fetch /stable/quote for each ticker; returns dict keyed by ticker."""
    results = {}
    for i, ticker in enumerate(tickers):
        print(f"  [{i+1}/{len(tickers)}] Fetching quote for {ticker}...")
        data = fmp_get(f"/quote?symbol={ticker}", apikey)
        if data and isinstance(data, list) and data:
            q = data[0]
            results[ticker] = {
                "price":      q.get("price"),
                "market_cap": q.get("marketCap"),   # in dollars
                "shares":     q.get("sharesOutstanding"),
                "fmp_pe":     q.get("pe"),           # FMP's own P/E (for reference only)
                "fmp_eps":    q.get("eps"),
            }
        elif data and isinstance(data, dict):
            results[ticker] = {
                "price":      data.get("price"),
                "market_cap": data.get("marketCap"),
                "shares":     data.get("sharesOutstanding"),
                "fmp_pe":     data.get("pe"),
                "fmp_eps":    data.get("eps"),
            }
        else:
            print(f"    Warning: no quote data for {ticker}")
            results[ticker] = {"price": None, "market_cap": None, "shares": None}
        time.sleep(delay)
    return results

# ---------------------------------------------------------------------------
# Rate base logic
# ---------------------------------------------------------------------------
# Regulated utilities — always show P/E, never EBITDA
REGULATED_TICKERS = {
    "NEE","D","ETR","CMS","PPL","AEE","POR","EIX","PCG","HE","EVRG","ES","AQN",
    "AWR","CWT","MSEX","YORW","GWRS","AWK","WTRG","HTO",
}

def get_rate_base(co, ip_entry=None):
    """
    Returns (opco_rb_b, opco_label, opco_source, opco_parts, consolidated_rb_b, consol_label, consol_source).

    consolidated_rb_b: investor presentation value (authoritative) → used for FV/RB
    opco_parts:        rate case filings per opco → used for display/audit trail
    """
    opcos = co.get("rate_base_opcos") or {}

    # Opco detail from rate case filings (display only)
    opco_parts = []
    for name, opco in opcos.items():
        rb_m = opco.get("rate_base_m")
        if rb_m and isinstance(rb_m, (int, float)):
            opco_parts.append({
                "company": opco.get("company", name),
                "rate_base_b": round(rb_m / 1000, 3),
                "label": opco.get("label", ""),
                "source": opco.get("source", "rate_case"),
            })

    # Consolidated rate base for FV/RB multiple:
    # Priority: (1) IP-disclosed, (2) NUP balance sheet, (3) net_ppe
    if ip_entry and ip_entry.get("rate_base_b"):
        consolidated_rb_b = ip_entry["rate_base_b"]
        consol_label = f"IP-Disclosed: {ip_entry.get('label','')} ({ip_entry.get('year','')})"
        consol_source = "investor_presentation"
    else:
        nup = co.get("net_utility_plant_latest")
        net_ppe = co.get("net_ppe") or []
        net_ppe_latest = next((x for x in reversed(net_ppe) if isinstance(x, (int, float))), None)
        if nup and isinstance(nup, (int, float)) and nup > 0:
            consolidated_rb_b = round(nup / 1e6, 3)
            consol_label = "Net Utility Plant (Balance Sheet, CapIQ)"
            consol_source = "net_utility_plant"
        elif net_ppe_latest and net_ppe_latest > 0:
            consolidated_rb_b = round(net_ppe_latest / 1e6, 3)
            consol_label = "Net PP&E (Balance Sheet, CapIQ)"
            consol_source = "net_ppe"
        else:
            consolidated_rb_b = None
            consol_label = "N/A"
            consol_source = "none"

    # Opco summary (for display label)
    if opco_parts:
        labels = list({p["label"] for p in opco_parts})
        opco_label = f"Rate Case: {'; '.join(labels)}"
        opco_rb_b  = round(sum(p["rate_base_b"] for p in opco_parts), 3)
    else:
        opco_rb_b  = consolidated_rb_b
        opco_label = consol_label

    return opco_rb_b, opco_label, "rate_case" if opco_parts else consol_source, opco_parts, consolidated_rb_b, consol_label, consol_source

# ---------------------------------------------------------------------------
# Safe numeric helpers
# ---------------------------------------------------------------------------
def safe_div(num, den, scale=1, decimals=2):
    try:
        if num is None or den is None or den == 0:
            return None
        return round((num / den) * scale, decimals)
    except Exception:
        return None

def safe_val(v):
    """Return v if numeric, else None."""
    return v if isinstance(v, (int, float)) else None

def get_eps_at(co, idx):
    eps = co.get("eps_diluted", [])
    if isinstance(eps, list) and len(eps) > idx:
        v = eps[idx]
        return safe_val(v)
    return None

def get_period_at(co, idx):
    periods = co.get("periods", [])
    if isinstance(periods, list) and len(periods) > idx:
        return periods[idx]
    return None

# ---------------------------------------------------------------------------
# Main: fetch quotes and build output
# ---------------------------------------------------------------------------
print("\nFetching live quotes from FMP...")
quotes = fetch_quotes(tickers, args.apikey, delay=args.delay)

print("\nBuilding market_data.json...")
output = {
    "generated": datetime.now().isoformat(timespec="seconds"),
    "source_notes": {
        "price": "FMP /stable/quote (live)",
        "equity_value": "FMP marketCap (live, dollars)",
        "net_debt": "CapIQ export, latest period (thousands -> converted to B)",
        "firm_value": "equity_value + net_debt (derived)",
        "eps_estimates": "CapIQ export consensus EPS, periods[4]/[5]/[6]",
        "dividends": "CapIQ export dividends_ps[-1] (most recent annual)",
        "rate_base": "CapIQ rate_base_opcos (rate case) or net_utility_plant_latest (balance sheet fallback)",
    },
    "companies": {}
}

for ticker, co in companies.items():
    q = quotes.get(ticker, {})
    price = safe_val(q.get("price"))
    mktcap_raw = q.get("market_cap")  # FMP: dollars
    equity_value_b = round(mktcap_raw / 1e9, 3) if mktcap_raw else None

    # Net debt from capiq (thousands -> billions)
    nd_series = co.get("net_debt", [])
    nd_vals = [x for x in (nd_series if isinstance(nd_series, list) else []) if isinstance(x, (int, float))]
    net_debt_b = round(nd_vals[-1] / 1e6, 3) if nd_vals else None

    # Firm value
    firm_value_b = round(equity_value_b + net_debt_b, 3) if (equity_value_b is not None and net_debt_b is not None) else None

    # EPS estimates from capiq (periods[4]=FY, [5]=FY+1, [6]=FY+2)
    eps_fy  = get_eps_at(co, 4)
    eps_fy1 = get_eps_at(co, 5)
    eps_fy2 = get_eps_at(co, 6)
    fy_label  = get_period_at(co, 4)
    fy1_label = get_period_at(co, 5)
    fy2_label = get_period_at(co, 6)

    # P/E ratios (price / forward EPS)
    pe_fy  = safe_div(price, eps_fy,  decimals=1)
    pe_fy1 = safe_div(price, eps_fy1, decimals=1)
    pe_fy2 = safe_div(price, eps_fy2, decimals=1)

    # Dividends (most recent annual from capiq)
    divs = co.get("dividends_ps", [])
    div_vals = [x for x in (divs if isinstance(divs, list) else []) if isinstance(x, (int, float))]
    div_per_share = div_vals[-1] if div_vals else None

    # Div yield and payout
    div_yield_pct  = safe_div(div_per_share, price,  scale=100, decimals=2)
    payout_pct     = safe_div(div_per_share, eps_fy, scale=100, decimals=1)

    # Rate base
    ip_entry = ip_data.get(ticker)
    opco_rb_b, opco_label, opco_source, rate_base_opco_detail, consolidated_rb_b, consol_label, consol_source = get_rate_base(co, ip_entry)

    # FV / Rate Base multiple
    is_regulated = ticker in REGULATED_TICKERS
    fv_rate_base_x = safe_div(firm_value_b, consolidated_rb_b, decimals=2) if (is_regulated and consolidated_rb_b) else None

    output["companies"][ticker] = {
        # Identity
        "ticker":   ticker,
        "name":     co.get("name", ""),

        # Live market data (FMP)
        "price":            price,
        "equity_value_b":   equity_value_b,

        # Derived balance sheet
        "net_debt_b":       net_debt_b,
        "firm_value_b":     firm_value_b,

        # Rate base — opco detail (rate case filings, for display/audit)
        "rate_base_opco_b":       opco_rb_b,
        "rate_base_opco_label":   opco_label,
        "rate_base_opco_source":  opco_source,
        "rate_base_opco_detail":  rate_base_opco_detail,
        # Rate base — consolidated (IP-disclosed or NUP, for FV/RB multiple)
        "consolidated_rb_b":      consolidated_rb_b,
        "consol_label":           consol_label,
        "consol_source":          consol_source,
        "is_regulated":           is_regulated,

        # Key multiple (uses IP-disclosed or NUP consolidated rate base)
        "fv_rate_base_x":   fv_rate_base_x,

        # EPS estimates (CapIQ consensus)
        "eps_fy":    eps_fy,   "fy_label":  fy_label,
        "eps_fy1":   eps_fy1,  "fy1_label": fy1_label,
        "eps_fy2":   eps_fy2,  "fy2_label": fy2_label,

        # P/E
        "pe_fy":  pe_fy,
        "pe_fy1": pe_fy1,
        "pe_fy2": pe_fy2,

        # Dividend
        "div_per_share":  div_per_share,
        "div_yield_pct":  div_yield_pct,
        "payout_pct":     payout_pct,
    }

# ---------------------------------------------------------------------------
# Write output
# ---------------------------------------------------------------------------
with open(args.out, "w", encoding="utf-8") as f:
    json.dump(output, f, indent=2)

print(f"\nWrote {args.out}")

# ---------------------------------------------------------------------------
# Summary table
# ---------------------------------------------------------------------------
print(f"\n{'Ticker':<6} {'Price':>7} {'EqVal':>7} {'FV':>7} {'RB':>7} {'FV/RB':>6} {'PE FY':>6} {'DivY%':>6} {'RB Source'}")
print("-" * 90)
for ticker, d in output["companies"].items():
    def fmt(v, fmt=".1f", suffix=""):
        return f"{v:{fmt}}{suffix}" if v is not None else "N/A"
    print(
        f"{ticker:<6} "
        f"{fmt(d['price'], '7.2f'):>7} "
        f"{fmt(d['equity_value_b'], '6.1f', 'B'):>7} "
        f"{fmt(d['firm_value_b'],   '6.1f', 'B'):>7} "
        f"{fmt(d['consolidated_rb_b'],'6.1f', 'B'):>7} "
        f"{fmt(d['fv_rate_base_x'], '5.2f', 'x'):>6} "
        f"{fmt(d['pe_fy'],          '5.1f', 'x'):>6} "
        f"{fmt(d['div_yield_pct'],  '5.2f', '%'):>6} "
        f"  {d['rate_base_source']}"
    )

print(f"\nDone. Generated: {output['generated']}")